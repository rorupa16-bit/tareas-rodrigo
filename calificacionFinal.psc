Algoritmo calificacionFinal
	// Ingresar la calificación final de un alumno, si la nota es mas de 70 decir aprobado, sino, es reprobado.
	Definir calificacion Como Real;
	Escribir "Ingresa tu calificación :";
	Leer calificacion;
	Si calificacion >= 70 Entonces
		Escribir "Aprobado";
	SiNo
		Escribir "Reprobado";
	FinSi
	
FinAlgoritmo
