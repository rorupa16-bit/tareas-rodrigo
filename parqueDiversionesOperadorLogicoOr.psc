Algoritmo parqueDiversiones
	//Elabora un pseudocódigo que pida la edad del usuario y evalúe si tiene derecho a la entrada gratuita mediante el operador lógico or
	Definir edad Como Entero
	Escribir "Introduce tu edad: ";
	Leer edad;
	Si edad <= 12 O edad >= 60 Entonces
		Escribir "Tienes la entrada gratuita";
	SiNo
		Escribir "Pagas la entrada";
	FinSi
	
FinAlgoritmo
